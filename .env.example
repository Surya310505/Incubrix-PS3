DATA_DIR=/app/data
OUTPUT_DIR=/app/data/outputs
DB_PATH=/app/data/jobs.sqlite3
LOG_LEVEL=INFO
MAX_AUDIO_SECONDS=600
MAX_AUDIO_UPLOAD_BYTES=104857600
AUDIO_DOWNLOAD_TIMEOUT_SECONDS=30
AUDIO_URL_ALLOWED_HOSTS=
MAX_SCRIPT_CHARACTERS=30000
MAX_SCENES=100
MEDIA_COMMAND_TIMEOUT_SECONDS=300
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_MODEL_DIR=
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
ESPEAK_BINARY=espeak-ng
ESPEAK_VOICE=en
SAY_BINARY=say
SAY_VOICE=
FOOTAGE_PROVIDER=offline
PEXELS_API_KEY=
PEXELS_USE_APPROVED=false
# Optional S3-compatible storage. Leave the endpoint empty for filesystem storage.
OBJECT_STORE_ENDPOINT_URL=
OBJECT_STORE_ACCESS_KEY_ID=
OBJECT_STORE_SECRET_ACCESS_KEY=
OBJECT_STORE_BUCKET=incubrix-outputs
OBJECT_STORE_REGION=us-east-1
